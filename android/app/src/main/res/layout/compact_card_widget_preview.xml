<?xml version="1.0" encoding="utf-8"?>
<!-- Static sample of the compact card style, shown by the widget picker on Android 12 and later. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_content_background"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="@string/course_widget_preview_date"
                android:textColor="@color/course_widget_content_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="@string/course_widget_preview_week"
                android:textColor="@color/course_widget_content_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/course_1_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_header"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/course_1_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_preview_card"
                android:tint="@color/course_widget_preview_accent_1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/course_1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/course_widget_preview_course_1_name"
                    android:textColor="@color/course_widget_preview_on_accent"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/course_1_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/course_widget_preview_course_1_place"
                    android:textColor="@color/course_widget_preview_on_accent"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/course_1_start_time"
                    style="@style/WidgetCourseTimeTextCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/course_widget_preview_course_1_range"
                    android:textColor="@color/course_widget_preview_on_accent" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/course_2_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/course_1_card"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/course_2_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_preview_card"
                android:tint="@color/course_widget_preview_accent_2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/course_2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/course_widget_preview_course_2_name"
                    android:textColor="@color/course_widget_preview_on_accent"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/course_2_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/course_widget_preview_course_2_place"
                    android:textColor="@color/course_widget_preview_on_accent"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/course_2_start_time"
                    style="@style/WidgetCourseTimeTextCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/course_widget_preview_course_2_range"
                    android:textColor="@color/course_widget_preview_on_accent" />
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>
</LinearLayout>
