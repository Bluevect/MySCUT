<!-- Two cell widget, updatePeriodMillis is the refresh floor without the exact alarm permission. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="@dimen/course_widget_min_side"
    android:minHeight="@dimen/course_widget_min_side"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/compact_card_widget_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
